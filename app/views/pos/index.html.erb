<div class="h-screen flex flex-col"
     data-controller="pos"
     style="background-image: url('<%= asset_path('background.png') %>'); background-size: cover; background-position: center; background-attachment: fixed;">

  <!-- CONTAINER 1: Top Navbar - Fixed -->
  <nav class="bg-white/90 backdrop-blur-sm shadow-lg border-b border-gray-200 flex-shrink-0">
    <div class="px-4 py-2">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center overflow-hidden">
            <%= image_tag "Gem_point.png", class: "w-full h-full object-cover", alt: "Logo" %>
          </div>
          <span class="font-bold text-lg text-gray-800">GemPoint POS</span>
        </div>
        
        <div class="flex items-center space-x-1 md:space-x-3">
          <%= link_to pos_path, class: "px-3 py-1.5 rounded-lg bg-blue-500 text-white text-sm font-medium flex items-center space-x-1" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-1.5 6M17 13l1.5 6M9 21h6M12 15v6"/></svg>
            <span>POS</span>
          <% end %>
          
          <%= link_to "#", class: "px-3 py-1.5 rounded-lg text-gray-600 hover:bg-gray-100 transition text-sm flex items-center space-x-1" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
            <span>Services</span>
          <% end %>
          
          <% if current_user.admin? %>
            <%= link_to "#", class: "px-3 py-1.5 rounded-lg text-gray-600 hover:bg-gray-100 transition text-sm flex items-center space-x-1" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              <span>Inventory</span>
            <% end %>
            <%= link_to "#", class: "px-3 py-1.5 rounded-lg text-gray-600 hover:bg-gray-100 transition text-sm flex items-center space-x-1" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              <span>Reports</span>
            <% end %>
            <%= link_to "#", class: "px-3 py-1.5 rounded-lg text-gray-600 hover:bg-gray-100 transition text-sm flex items-center space-x-1" do %>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Settings</span>
            <% end %>
          <% else %>
            <span class="px-3 py-1.5 rounded-lg text-gray-400 cursor-not-allowed text-sm flex items-center space-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              <span>Inventory</span>
            </span>
            <span class="px-3 py-1.5 rounded-lg text-gray-400 cursor-not-allowed text-sm flex items-center space-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              <span>Reports</span>
            </span>
            <span class="px-3 py-1.5 rounded-lg text-gray-400 cursor-not-allowed text-sm flex items-center space-x-1">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              <span>Settings</span>
            </span>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <!-- CONTAINER 2 & 3: Main Display + Side Container -->
  <div class="flex flex-1 min-h-0 p-3 gap-3">
    
    <!-- CONTAINER 2: Main Display -->
    <div class="flex-1 bg-white/90 backdrop-blur-sm rounded-xl shadow-lg flex flex-col min-w-0">
      <div class="p-3 border-b border-gray-200 flex-shrink-0">
        <div class="relative mb-2">
          <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" 
                 data-pos-target="barcodeSearch"
                 data-action="keyup->pos#searchProducts"
                 placeholder="Scan barcode or search product..." 
                 class="w-full pl-9 pr-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
        </div>
        
        <div class="flex items-center gap-2">
          <div class="relative flex-1">
            <select id="sort-select" 
                    data-action="change->pos#sortProducts"
                    class="w-full px-3 py-2 text-sm border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400 appearance-none bg-white">
              <option value="name_asc">Sort by: Name A-Z</option>
              <option value="name_desc">Sort by: Name Z-A</option>
              <option value="price_asc">Sort by: Price (Low to High)</option>
              <option value="price_desc">Sort by: Price (High to Low)</option>
              <option value="stock_asc">Sort by: Stock (Low to High)</option>
              <option value="stock_desc">Sort by: Stock (High to Low)</option>
            </select>
            <svg class="absolute right-3 top-1/2 transform -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
          
          <button id="category-filter-btn"
                  data-action="click->pos#toggleCategoryModal"
                  class="px-3 py-2 text-sm bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition flex items-center space-x-1 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
            <span>Category</span>
          </button>
          
          <button id="clear-filters-btn"
                  data-action="click->pos#clearFilters"
                  class="px-3 py-2 text-sm bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition flex items-center space-x-1 flex-shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            <span>Clear</span>
          </button>
        </div>
        
        <div id="active-filters" class="flex flex-wrap gap-1 mt-2 text-xs"></div>
      </div>
      
      <div class="flex-1 overflow-y-auto p-3">
        <div id="products-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
          <% if @products && @products.any? %>
            <% @products.each do |product| %>
              <button class="product-btn bg-white rounded-lg shadow p-3 hover:shadow-md active:scale-95 transition-all text-left"
                      data-action="click->pos#addToCart"
                      data-product-id="<%= product.id %>"
                      data-product-name="<%= product.name %>"
                      data-product-price="<%= product.price %>"
                      data-category-id="<%= product.category_id %>"
                      data-stock="<%= product.quantity %>"
                      data-barcode="<%= product.barcode %>">
                <div class="text-sm font-semibold text-gray-800"><%= product.name %></div>
                <div class="text-base font-bold text-green-600 mt-1">₱<%= product.price %></div>
                <div class="text-xs text-gray-500 mt-1">Stock: <%= product.quantity %></div>
              </button>
            <% end %>
          <% else %>
            <div class="col-span-full text-center text-gray-500 py-8">
              No products found. Add products in Inventory.
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- CONTAINER 3: Side Container (Cart) -->
    <div class="w-80 bg-white/90 backdrop-blur-sm rounded-xl shadow-lg flex flex-col flex-shrink-0">
      <div class="p-3 border-b border-gray-200 flex-shrink-0">
        <h2 class="text-lg font-bold text-gray-800 flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span>Current Sale</span>
        </h2>
      </div>
      
      <div data-pos-target="cartItems" class="flex-1 overflow-y-auto p-3">
        <div class="text-center text-gray-400 py-8">
          <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <p class="text-sm">No items in cart</p>
          <p class="text-xs mt-1">Tap products to add</p>
        </div>
      </div>
      
      <div class="border-t border-gray-200 p-3 space-y-2 flex-shrink-0">
        <div class="flex justify-between text-base font-bold">
          <span>TOTAL</span>
          <span data-pos-target="cartTotal" class="text-green-600">₱0.00</span>
        </div>
        
        <button data-action="click->pos#processCashPayment" 
                class="w-full bg-green-500 text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-green-600 transition active:scale-95 flex items-center justify-center space-x-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>CASH PAYMENT</span>
        </button>
        
        <div class="grid grid-cols-2 gap-2">
          <button data-action="click->pos#showPaymentModal" 
                  class="bg-blue-500 text-white py-2 rounded-lg text-xs font-medium hover:bg-blue-600 transition active:scale-95 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
            <span>OTHER</span>
          </button>
          
          <button data-action="click->pos#showClearCartModal" 
                  class="bg-red-100 text-red-600 py-2 rounded-lg text-xs font-medium hover:bg-red-200 transition active:scale-95 flex items-center justify-center space-x-1">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            <span>CLEAR</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- CATEGORY FILTER MODAL - GRID LAYOUT -->
  <div id="category-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeCategoryModalOnBackground">
    
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-purple-500 to-purple-600 px-6 py-5">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white">Filter by Category</h3>
            <p class="text-purple-100 text-sm mt-1">Select a category to filter products</p>
          </div>
          <button data-action="click->pos#closeCategoryModal" class="text-white hover:text-purple-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      
      <div class="p-5 max-h-[70vh] overflow-y-auto">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
          <!-- All Products Option -->
          <button data-action="click->pos#filterByCategory" data-category-id="all" 
                  class="category-option bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
            <div class="text-4xl mb-2">📦</div>
            <div class="font-semibold text-gray-800 text-sm">All Products</div>
            <div class="text-xs text-gray-500 mt-1"><%= Product.active.count %> items</div>
          </button>
          
          <!-- Category List -->
          <% Category.where(its_active: true).order(:name).each do |category| %>
            <button data-action="click->pos#filterByCategory" data-category-id="<%= category.id %>" 
                    class="category-option bg-gradient-to-br from-blue-50 to-indigo-100 rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
              <div class="text-4xl mb-2">
                <% if category.name == 'Beverages' %>🥤
                <% elsif category.name == 'Snacks' %>🍿
                <% elsif category.name == 'Canned Goods' %>🥫
                <% elsif category.name == 'Noodles' %>🍜
                <% elsif category.name == 'Rice & Grains' %>🍚
                <% elsif category.name == 'Dairy' %>🥛
                <% elsif category.name == 'Personal Care' %>🧴
                <% else %>📦
                <% end %>
              </div>
              <div class="font-semibold text-gray-800 text-sm"><%= category.name %></div>
              <div class="text-xs text-gray-500 mt-1"><%= Product.where(category: category, is_active: true).count %> items</div>
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- PAYMENT METHOD MODAL -->
  <div id="payment-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeModalOnBackground">
    
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-blue-500 to-blue-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white">Payment Confirmation</h3>
            <p class="text-blue-100 text-sm mt-1">Review items and select payment method</p>
          </div>
          <button data-action="click->pos#closeModal" class="text-white hover:text-blue-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      
      <div class="p-5">
        <div class="bg-gray-50 rounded-xl p-3 mb-4 max-h-48 overflow-y-auto">
          <div id="modal-item-list" class="space-y-2"></div>
        </div>
        
        <div class="bg-gray-100 rounded-xl p-3 mb-4">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 font-medium">Total:</span>
            <span class="text-2xl font-bold text-green-600" id="modal-total">₱0.00</span>
          </div>
          <div class="flex justify-between text-xs text-gray-500 mt-1">
            <span>Total Items:</span>
            <span id="modal-item-count">0</span>
          </div>
        </div>
        
        <p class="text-sm font-medium text-gray-700 mb-2">Select Payment Method:</p>
        <div class="grid grid-cols-2 gap-3">
          <button data-action="click->pos#processPayment" data-method="cash" 
                  class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
            <div class="text-3xl mb-1">💵</div>
            <div class="font-semibold text-sm">Cash</div>
          </button>
          
          <button data-action="click->pos#processPayment" data-method="gcash" 
                  class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
            <div class="text-3xl mb-1">📱</div>
            <div class="font-semibold text-sm">GCash</div>
          </button>
          
          <button data-action="click->pos#processPayment" data-method="paymaya" 
                  class="bg-gradient-to-br from-yellow-500 to-yellow-600 text-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
            <div class="text-3xl mb-1">💳</div>
            <div class="font-semibold text-sm">PayMaya</div>
          </button>
          
          <button data-action="click->pos#processPayment" data-method="credit" 
                  class="bg-gradient-to-br from-red-500 to-red-600 text-white rounded-xl p-4 text-center hover:shadow-lg transition-all hover:scale-105 active:scale-95">
            <div class="text-3xl mb-1">📝</div>
            <div class="font-semibold text-sm">Credit</div>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- CASH PAYMENT CONFIRMATION MODAL - TABLET OPTIMIZED -->
  <div id="cash-confirm-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden p-4"
       data-action="click->pos#closeCashConfirmModalOnBackground">
    
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl mx-auto overflow-hidden transition-all duration-300 ease-out">
      
      <!-- Modal Header -->
      <div class="bg-gradient-to-r from-green-500 to-green-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white">Cash Payment</h3>
            <p class="text-green-100 text-sm mt-1">Enter amount to complete transaction</p>
          </div>
          <button data-action="click->pos#closeCashConfirmModal" class="text-white hover:text-green-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      
      <!-- Two Column Layout for Tablet -->
      <div class="flex flex-col md:flex-row">
        
        <!-- LEFT COLUMN: Keypad -->
        <div class="md:w-1/2 bg-gray-50 p-5">
          <div class="text-center mb-4">
            <div class="bg-white rounded-xl p-4 shadow-sm">
              <div class="text-xs text-gray-500 uppercase tracking-wide mb-1">Amount Received</div>
              <div class="text-4xl font-bold text-green-600" id="keypad-amount">₱0.00</div>
            </div>
          </div>
          
          <!-- Numeric Keypad -->
          <div class="grid grid-cols-3 gap-3 mb-4">
            <button data-action="click->pos#keypadPress" data-value="7" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">7</button>
            <button data-action="click->pos#keypadPress" data-value="8" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">8</button>
            <button data-action="click->pos#keypadPress" data-value="9" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">9</button>
            <button data-action="click->pos#keypadPress" data-value="4" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">4</button>
            <button data-action="click->pos#keypadPress" data-value="5" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">5</button>
            <button data-action="click->pos#keypadPress" data-value="6" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">6</button>
            <button data-action="click->pos#keypadPress" data-value="1" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">1</button>
            <button data-action="click->pos#keypadPress" data-value="2" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">2</button>
            <button data-action="click->pos#keypadPress" data-value="3" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">3</button>
            <button data-action="click->pos#keypadPress" data-value="00" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">00</button>
            <button data-action="click->pos#keypadPress" data-value="0" 
                    class="keypad-btn bg-white hover:bg-gray-100 active:scale-95 text-2xl font-semibold text-gray-800 py-5 rounded-xl shadow-sm transition-all">0</button>
            <!-- Backspace/Delete Button -->
            <button data-action="click->pos#keypadBackspace" 
                    class="keypad-btn bg-orange-100 hover:bg-orange-200 active:scale-95 text-orange-700 py-5 rounded-xl shadow-sm transition-all flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 001.414.586H19a2 2 0 002-2V7a2 2 0 00-2-2h-8.172a2 2 0 00-1.414.586L3 12z"/>
              </svg>
            </button>
          </div>
          
          <!-- Action Buttons -->
          <div class="grid grid-cols-2 gap-3">
            <button data-action="click->pos#keypadClear" 
                    class="bg-yellow-100 text-yellow-700 py-4 rounded-xl text-base font-semibold hover:bg-yellow-200 transition-all active:scale-95">
              Clear All
            </button>
            <button id="confirm-cash-payment-btn" 
                    data-action="click->pos#confirmCashPayment"
                    class="bg-green-500 text-white py-4 rounded-xl text-base font-semibold hover:bg-green-600 transition-all active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
              Confirm Payment
            </button>
          </div>
        </div>
        
        <!-- RIGHT COLUMN: Payment Summary -->
        <div class="md:w-1/2 bg-white p-5">
          <!-- Items List -->
          <div class="mb-4">
            <h4 class="text-sm font-semibold text-gray-500 mb-2 uppercase tracking-wide">Items</h4>
            <div class="bg-gray-50 rounded-xl p-3 max-h-48 overflow-y-auto">
              <div id="cash-confirm-item-list" class="space-y-2"></div>
            </div>
          </div>
          
          <!-- Totals -->
          <div class="bg-gray-100 rounded-xl p-4 mb-4">
            <div class="flex justify-between items-center mb-2">
              <span class="text-gray-600">Subtotal:</span>
              <span class="text-lg font-semibold text-gray-800" id="cash-confirm-subtotal">₱0.00</span>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-gray-200">
              <span class="text-gray-800 font-bold text-lg">TOTAL:</span>
              <span class="text-2xl font-bold text-green-600" id="cash-confirm-total">₱0.00</span>
            </div>
            <div class="flex justify-between text-xs text-gray-500 mt-1">
              <span>Total Items:</span>
              <span id="cash-confirm-item-count">0</span>
            </div>
          </div>
          
          <!-- Amount Received Display (Live update) -->
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-2">Amount Received</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500 text-xl">₱</span>
              <input type="text" id="cash-amount-received" 
                    class="w-full pl-8 pr-4 py-4 text-2xl font-bold border-2 border-gray-200 rounded-xl focus:outline-none focus:border-green-400 bg-gray-50"
                    placeholder="0.00"
                    readonly>
            </div>
          </div>
          
          <!-- Change Display -->
          <div class="bg-green-50 rounded-xl p-4 mb-4 border-2 border-green-200">
            <div class="flex justify-between items-center">
              <span class="text-gray-700 font-semibold text-base">Change:</span>
              <span class="text-2xl font-bold text-green-600" id="cash-change-amount">₱0.00</span>
            </div>
          </div>
          
          <!-- Cancel Button Only (Confirm moved to left panel) -->
          <button data-action="click->pos#closeCashConfirmModal" 
                  class="w-full bg-gray-200 text-gray-700 py-4 rounded-xl text-base font-medium hover:bg-gray-300 transition-all active:scale-95">
            Cancel
          </button>
        </div>
        
      </div>
    </div>
  </div>

  <!-- CREDIT MODAL -->
  <div id="credit-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeCreditModalOnBackground">
    
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-red-500 to-red-600 px-6 py-4">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white">Credit Sale</h3>
            <p class="text-red-100 text-sm mt-1">Record customer debt information</p>
          </div>
          <button data-action="click->pos#closeCreditModal" class="text-white hover:text-red-200">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      
      <div class="p-5">
        <div class="bg-gray-50 rounded-xl p-3 mb-4 max-h-40 overflow-y-auto">
          <div id="credit-item-list" class="space-y-2"></div>
        </div>
        
        <div class="bg-gray-100 rounded-xl p-3 mb-4">
          <div class="flex justify-between items-center">
            <span class="text-gray-600 font-medium">Total Debt:</span>
            <span class="text-2xl font-bold text-red-600" id="credit-total">₱0.00</span>
          </div>
        </div>
        
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Customer Name *</label>
            <input type="text" id="credit-customer-name" 
                   class="w-full px-4 py-3 text-base border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                   placeholder="Enter customer full name">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Contact Number (Optional)</label>
            <input type="tel" id="credit-customer-phone" 
                   class="w-full px-4 py-3 text-base border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                   placeholder="0917 123 4567">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Due Date (Optional)</label>
            <input type="date" id="credit-due-date" 
                   class="w-full px-4 py-3 text-base border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent">
          </div>
          
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Notes (Optional)</label>
            <textarea id="credit-notes" rows="2" 
                      class="w-full px-4 py-3 text-base border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent"
                      placeholder="Additional notes..."></textarea>
          </div>
        </div>
        
        <div class="flex gap-3 mt-5">
          <button data-action="click->pos#closeCreditModal" 
                  class="flex-1 bg-gray-200 text-gray-700 py-3 rounded-xl text-base font-medium hover:bg-gray-300 transition">Cancel</button>
          <button data-action="click->pos#confirmCreditSale" 
                  class="flex-1 bg-red-500 text-white py-3 rounded-xl text-base font-semibold hover:bg-red-600 transition">Confirm Credit Sale</button>
        </div>
      </div>
    </div>
  </div>

  <!-- RECEIPT STYLE SUCCESS MODAL -->
  <div id="success-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeSuccessModal">
    
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden transform transition-all max-h-[90vh] overflow-y-auto">
      <div class="bg-gradient-to-r from-green-500 to-green-600 px-5 py-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <h3 class="text-lg font-bold text-white">Payment Successful!</h3>
          </div>
          <button data-action="click->pos#closeSuccessModal" class="text-white hover:text-green-100">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
      
      <div id="receipt-content" class="p-5">
        <!-- Receipt content will be inserted here -->
      </div>
      
      <div class="border-t border-gray-100 px-5 py-3 bg-gray-50">
        <button data-action="click->pos#closeSuccessModal" 
                class="w-full bg-green-500 text-white py-2 rounded-lg text-sm font-medium hover:bg-green-600 transition">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- CART EMPTY NOTICE MODAL -->
  <div id="empty-cart-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeEmptyCartModal">
    
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-xs mx-4 overflow-hidden transform transition-all">
      <div class="bg-gradient-to-r from-yellow-500 to-orange-500 px-5 py-4 text-center">
        <svg class="w-12 h-12 mx-auto text-white mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <h3 class="text-xl font-bold text-white">Cart is Empty</h3>
      </div>
      
      <div class="p-5 text-center">
        <p class="text-gray-600 text-sm mb-4">No items in cart to process payment.</p>
        <p class="text-gray-400 text-xs mb-4">Please add products to continue.</p>
        <button data-action="click->pos#closeEmptyCartModal" 
                class="w-full bg-blue-500 text-white py-2 rounded-lg text-sm font-medium hover:bg-blue-600 transition">OK</button>
      </div>
    </div>
  </div>

  <!-- CLEAR CART CONFIRMATION MODAL -->
  <div id="clear-cart-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeClearCartModalOnBackground">
    
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-xs mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-red-500 to-red-600 px-5 py-4">
        <h3 class="text-xl font-bold text-white">Clear Cart</h3>
        <p class="text-red-100 text-sm mt-1">Confirm removal of all items</p>
      </div>
      
      <div class="p-5">
        <div class="text-center">
          <svg class="w-12 h-12 mx-auto mb-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <p class="text-gray-800 text-base font-semibold mb-2">Are you sure?</p>
          <p class="text-gray-500 text-xs">
            This will remove <span id="clear-cart-item-count" class="font-bold text-red-600">0</span> item(s)
            from your cart totaling <span id="clear-cart-total" class="font-bold text-red-600">₱0.00</span>
          </p>
          <p class="text-gray-400 text-xs mt-2">This action cannot be undone.</p>
        </div>
      </div>
      
      <div class="border-t border-gray-100 px-5 py-3 bg-gray-50 flex gap-2">
        <button data-action="click->pos#closeClearCartModal" 
                class="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg text-sm font-medium hover:bg-gray-300 transition">Cancel</button>
        <button data-action="click->pos#confirmClearCart" 
                class="flex-1 bg-red-500 text-white py-2 rounded-lg text-sm font-medium hover:bg-red-600 transition">Yes, Clear</button>
      </div>
    </div>
  </div>

  <!-- SWIPE TO REMOVE CONFIRMATION MODAL -->
  <div id="swipe-remove-modal" 
       class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center z-50 hidden"
       data-action="click->pos#closeSwipeModalOnBackground">
    
    <div class="bg-white rounded-xl shadow-2xl w-full max-w-xs mx-4 overflow-hidden">
      <div class="bg-gradient-to-r from-orange-500 to-red-500 px-5 py-4">
        <h3 class="text-xl font-bold text-white">Remove Item</h3>
        <p class="text-orange-100 text-sm mt-1">Confirm removal from cart</p>
      </div>
      
      <div class="p-5">
        <div class="text-center">
          <svg class="w-12 h-12 mx-auto mb-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <p class="text-gray-800 text-base font-semibold mb-2">Remove this item?</p>
          <p class="text-gray-500 text-xs">
            Are you sure you want to remove <br>
            <span id="swipe-item-name" class="font-bold text-red-600">item</span>?
          </p>
          <p class="text-gray-400 text-xs mt-2">Swipe detected - tap confirm to remove</p>
        </div>
      </div>
      
      <div class="border-t border-gray-100 px-5 py-3 bg-gray-50 flex gap-2">
        <button data-action="click->pos#closeSwipeModal" 
                class="flex-1 bg-gray-200 text-gray-700 py-2 rounded-lg text-sm font-medium hover:bg-gray-300 transition">Cancel</button>
        <button data-action="click->pos#confirmSwipeRemove" 
                class="flex-1 bg-red-500 text-white py-2 rounded-lg text-sm font-medium hover:bg-red-600 transition">Yes, Remove</button>
      </div>
    </div>
  </div>

  <!-- CONTAINER 4: Bottom Bar - Fixed -->
  <div class="bg-white/90 backdrop-blur-sm border-t border-gray-200 px-3 py-1.5 flex-shrink-0">
    <div class="flex items-center justify-between text-xs">
      <div class="flex items-center space-x-2">
        <div class="w-6 h-6 rounded-lg bg-gray-200 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <span><%= current_user.last_name %>, <%= current_user.first_name %></span>
        <span class="text-xs text-gray-400">(<%= current_user.role.upcase %>)</span>
      </div>
      <div id="current-datetime" class="text-gray-600 text-xs"></div>
      <%= button_to destroy_user_session_path, method: :delete, class: "text-red-500 text-xs hover:text-red-600 flex items-center space-x-1" do %>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>Logout</span>
      <% end %>
    </div>
  </div>
</div>