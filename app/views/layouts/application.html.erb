<!DOCTYPE html>
<html>
  <head>
    <title>MiniMart POS</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>
  <body class="bg-gray-50">
    <!-- Flash Messages with Auto-Dismiss -->
    <% if notice %>
      <div id="flash-notice" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 transition-all duration-500">
        <div class="bg-green-100 border border-green-400 text-green-700 px-6 py-3 rounded-lg shadow-lg flex items-center space-x-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= notice %></span>
          <button onclick="this.closest('#flash-notice').remove()" class="ml-4 text-green-700 hover:text-green-900">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    <% end %>
    
    <% if alert %>
      <div id="flash-alert" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 transition-all duration-500">
        <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-3 rounded-lg shadow-lg flex items-center space-x-3">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span><%= alert %></span>
          <button onclick="this.closest('#flash-alert').remove()" class="ml-4 text-red-700 hover:text-red-900">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
      </div>
    <% end %>
    
    <%= yield %>
    
    <!-- Auto-dismiss script -->
    <script>
      // Auto-dismiss flash messages after 3 seconds
      setTimeout(() => {
        const notice = document.getElementById('flash-notice');
        const alert = document.getElementById('flash-alert');
        
        if (notice) {
          notice.style.opacity = '0';
          setTimeout(() => notice.remove(), 500);
        }
        
        if (alert) {
          alert.style.opacity = '0';
          setTimeout(() => alert.remove(), 500);
        }
      }, 3000);
    </script>
  </body>
</html>